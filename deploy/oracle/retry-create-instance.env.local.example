# Copy this file to retry-create-instance.env.local (gitignored, never
# committed) and fill in your own tenancy's values.
#
# Find these via the OCI console or `oci` CLI once ~/.oci/config is set up
# (see README.md step 1 for the API key setup):
#   COMPARTMENT_ID        the root compartment = your tenancy OCID
#   IMAGE_ID              `oci compute image list --compartment-id <id> \
#                            --operating-system "Oracle Linux" \
#                            --operating-system-version 9 \
#                            --shape VM.Standard.A1.Flex`
#   SUBNET_ID              `oci network subnet list --compartment-id <id>`
#   AVAILABILITY_DOMAINS   `oci iam availability-domain list \
#                            --compartment-id <id>`

COMPARTMENT_ID="ocid1.tenancy.oc1..REPLACE_ME"
SHAPE="VM.Standard.A1.Flex"
SHAPE_CONFIG_JSON='{"ocpus":2,"memoryInGBs":12}'
IMAGE_ID="ocid1.image.oc1.iad.REPLACE_ME"
SUBNET_ID="ocid1.subnet.oc1.iad.REPLACE_ME"
SSH_KEY_FILE="$HOME/.ssh/your_key.pub"
AVAILABILITY_DOMAINS="xxxx:US-ASHBURN-AD-1 xxxx:US-ASHBURN-AD-2 xxxx:US-ASHBURN-AD-3"
